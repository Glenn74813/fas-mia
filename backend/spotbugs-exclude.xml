<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs / FindSecBugs suppressions. Each entry says why the pattern does not apply; new findings fail `mvn verify`.
  Reviewed in gap 12 (docs/16 §3j).
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
  <!-- Records, DTOs and Spring beans hand out and receive collections and dates by design; nothing is shared with untrusted code. -->
  <Match><Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/></Match>

  <!-- Finalizer attacks need untrusted subclasses; these are Spring singletons that fail fast on bad configuration. -->
  <Match><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>

  <!-- JdbcTemplate.queryForObject is annotated @Nullable; our calls select aggregates wrapped in coalesce() or single
       rows that throw EmptyResultDataAccessException, so the null path does not occur. -->
  <Match><Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/></Match>

  <!-- Every flagged statement was reviewed: the concatenated parts are constants, enum- or code-chosen table and column names,
       or clauses made only of ? placeholders. User input is always a bound parameter. SqlInjectionIT exercises the
       search and filter endpoints with injection payloads. -->
  <Match><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>

  <!-- The correlation id is echoed only after matching [A-Za-z0-9-]{8,64}; anything else is replaced by a random UUID. -->
  <Match><Class name="com.miaa.cas.common.web.CorrelationIdFilter"/><Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/></Match>

  <!-- Spring Security's Authentication is Serializable; the API is stateless (JWT), so it is never serialized. -->
  <Match><Class name="com.miaa.cas.security.CasAuthentication"/><Bug pattern="SE_BAD_FIELD,SE_NO_SERIALVERSIONID,SE_TRANSIENT_FIELD_NOT_RESTORED"/></Match>

  <!-- Text-block SQL used with String.formatted(): the line breaks are part of the SQL, not output. -->
  <Match><Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/></Match>

  <!-- Job runner and statement parser deliberately turn any failure into a recorded job error or a user-facing parse error. -->
  <Match><Class name="com.miaa.cas.financialreporting.ReportJobService"/><Bug pattern="REC_CATCH_EXCEPTION"/></Match>
  <Match><Class name="com.miaa.cas.treasury.statements.Camt053Parser"/><Bug pattern="REC_CATCH_EXCEPTION"/></Match>
</FindBugsFilter>
