# Copy to .env (never commit .env). Generate secrets with scripts/dev-secrets.sh.
# Used by scripts/run-backend-dev.sh (Docker Compose sets its own URL)
CAS_DB_URL=jdbc:postgresql://localhost:5432/cas
CAS_DB_USER=cas
CAS_DB_PASSWORD=
# base64-encoded 32 random bytes: openssl rand -base64 32. AES-256-GCM key for MFA secrets, supplier bank accounts and
# stored files (documents, report files, payment files). Losing it makes those unreadable; keep it in the secret store.
CAS_DATA_ENCRYPTION_KEY=
# Optional: creates the first System Administrator when none exists. Remove after first sign-in.
CAS_BOOTSTRAP_ADMIN_USERNAME=
CAS_BOOTSTRAP_ADMIN_EMAIL=
CAS_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: general API rate limit per signed-in user and per unauthenticated client address, per minute (all instances).
CAS_API_REQUESTS_PER_MINUTE=
CAS_ANONYMOUS_REQUESTS_PER_MINUTE=
# Optional: SMTP delivery of e-mails (off by default; in dev they are written to the log). Relay provider is C-16.
CAS_SMTP_ENABLED=false
CAS_SMTP_HOST=
CAS_SMTP_PORT=587
CAS_SMTP_USERNAME=
CAS_SMTP_PASSWORD=
CAS_MAIL_FROM=
